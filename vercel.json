{
  "version": 2,
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/server.ts"
    },
    {
      "source": "/sitemap.xsl",
      "destination": "/server.ts"
    },
    {
      "source": "/robots.txt",
      "destination": "/server.ts"
    },
    {
      "source": "/googlea4015d58ba6aed96.html",
      "destination": "/server.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/server.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
